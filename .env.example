# Copy this file to .env.local for local development.
# Add these values in Vercel Project Settings -> Environment Variables.
# Never commit real secrets or production credentials.

# Required: PostgreSQL / Neon connection string
DATABASE_URL=
# Optional: leave unset to require SSL (recommended for Neon)
# Set to "disable" only for a trusted local PostgreSQL connection.
DATABASE_SSL=

# Required: random secret of at least 32 characters; use a unique value in production.
SESSION_SECRET=

# Legacy admin login (configure ADMIN_USERNAME or ADMIN_EMAIL, plus ADMIN_PASSWORD)
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Super Admin login (configure SUPER_ADMIN_USERNAME or SUPER_ADMIN_EMAIL, plus SUPER_ADMIN_PASSWORD)
# Keep these credentials different from the regular admin credentials.
SUPER_ADMIN_USERNAME=
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Optional: password reset emails (Resend)
RESEND_API_KEY=
PASSWORD_RESET_FROM=
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=https://alumni-lemanhas.vercel.app

# Required for profile-photo upload using Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=alumni-lemhanas-foto
R2_PUBLIC_URL=
