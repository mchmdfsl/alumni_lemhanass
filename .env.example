# PostgreSQL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to disable only for a local database that does not use SSL.
DATABASE_SSL=require

# Admin biasa
ADMIN_USERNAME=admin
ADMIN_EMAIL=
ADMIN_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD

# Super Admin (gunakan kredensial berbeda dari admin biasa)
SUPER_ADMIN_USERNAME=superadmin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=CHANGE_THIS_TO_ANOTHER_STRONG_PASSWORD

# Secret minimal 32 karakter, acak, dan rahasia
SESSION_SECRET=CHANGE_THIS_TO_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS

# Cloudflare R2 untuk foto profil
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=alumni-lemhanas-foto
R2_PUBLIC_URL=

# Email reset password melalui Resend
RESEND_API_KEY=
PASSWORD_RESET_FROM=
# Alternatif alamat pengirim bila PASSWORD_RESET_FROM tidak diisi
EMAIL_FROM=
NEXT_PUBLIC_APP_URL=http://localhost:3000
